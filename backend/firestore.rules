rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSeller() {
      return isAuthenticated() && 
        (getUserData().role == 'seller' || getUserData().role == 'both');
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow creation during registration, update only by the user
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // Profiles cannot be deleted directly
    }

    // 2. Products Collection
    match /products/{productId} {
      allow read: if true; // Public catalog browsing
      // Only authenticated sellers can create products
      allow create: if isSeller() && request.resource.data.sellerId == request.auth.uid;
      // Only the seller who listed the product can modify it
      allow update: if isSeller() && resource.data.sellerId == request.auth.uid;
      allow delete: if isSeller() && resource.data.sellerId == request.auth.uid;
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      // Buyers can read their own orders; sellers can read orders involving their products
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.items[0].sellerId == request.auth.uid // Simple check for first item's seller
      );
      
      // Anyone authenticated can create an order (as a buyer)
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      
      // Buyers can only update cancel requests; sellers can update shipping status
      allow update: if isAuthenticated() && (
        (resource.data.buyerId == request.auth.uid && request.resource.data.status == 'cancelled') ||
        (resource.data.items[0].sellerId == request.auth.uid && request.resource.data.status != resource.data.status)
      );
      
      allow delete: if false; // Orders should never be deleted for audit history
    }
  }
}
